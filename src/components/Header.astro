---
import { Image } from "astro:assets";
import lockupInk from "../assets/lockup-ink.png";

const nav = [
  { href: "/servicios/", label: "Servicios" },
  { href: "/clinica-web-del-camino/", label: "Clínica del Camino" },
  { href: "/sobre/", label: "Sobre" },
  { href: "/contacto/", label: "Contacto" },
];
---

<header class="border-b border-tinta/10 bg-pergamino">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" aria-label="Sello Jaca — inicio" class="block">
      <Image src={lockupInk} alt="Sello Jaca" width={200} loading="eager" />
    </a>

    <nav class="hidden items-center gap-8 sm:flex" aria-label="Principal">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-tinta underline-offset-4 hover:text-cera hover:underline">
          {item.label}
        </a>
      ))}
      <a href="https://wa.me/34641314730" class="rounded-md bg-cera px-4 py-2 text-sm font-semibold text-white hover:bg-cera-oscura">
        WhatsApp
      </a>
    </nav>

    <details class="relative sm:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-tinta/20 px-3 py-2 text-sm font-medium marker:hidden">
        Menú
      </summary>
      <nav class="absolute right-0 top-full mt-2 flex w-48 flex-col gap-1 rounded-md border border-tinta/10 bg-pergamino p-2 shadow-lg" aria-label="Principal móvil">
        {nav.map((item) => (
          <a href={item.href} class="rounded px-3 py-2 text-sm font-medium hover:bg-tinta/5">
            {item.label}
          </a>
        ))}
        <a href="https://wa.me/34641314730" class="rounded bg-cera px-3 py-2 text-sm font-semibold text-white">
          WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>