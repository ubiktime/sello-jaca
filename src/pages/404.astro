---
import Base from "../layouts/Base.astro";
---

<Base
	title="Página no encontrada — Sello Jaca"
	description="La página que buscas no existe o ha cambiado de sitio. Vuelve al inicio de Sello Jaca o contacta directamente."
>
	<meta slot="head" name="robots" content="noindex" />

	<section class="mx-auto max-w-5xl px-4 py-24 text-center sm:py-32 [&>*]:mx-auto [&>*]:max-w-3xl">
		<p class="font-semibold text-cera">Error 404</p>
		<h1 class="mt-3 text-4xl font-bold leading-tight sm:text-5xl">Te has salido del Camino.</h1>
		<p class="mt-5 text-lg text-piedra">La página que buscas no existe o ha cambiado de sitio.</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<a href="/" class="rounded-md bg-cera px-5 py-3 font-semibold text-white hover:bg-cera-oscura">Volver al inicio</a>
			<a href="/contacto/" class="rounded-md border border-tinta/25 px-5 py-3 font-semibold hover:border-tinta">Contacto</a>
		</div>
	</section>
</Base>